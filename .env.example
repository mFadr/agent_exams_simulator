# Non-secret configuration examples only. NEVER put an API key in this file.
# API keys are entered in the app (AI Settings → API key) and stored in the
# Windows Credential Manager.

# Override where the app stores its data (default: %APPDATA%\AIExamSimulator)
# AIES_DATA_DIR=D:\ExamSimulatorData

# Run the UI without a display (used by the automated tests)
# QT_QPA_PLATFORM=offscreen
